{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yesdevnull/tf-version-bump/schema/config-schema.json",
  "title": "tf-version-bump Configuration",
  "description": "Configuration file for tf-version-bump to specify Terraform module version updates",
  "type": "object",
  "definitions": {
    "versionConstraint": {
      "type": "string",
      "minLength": 1,
      "description": "Terraform-compatible version constraint supporting SemVer, pre-release/build metadata, and operators like ~>, >=, <=, and != with optional chained constraints",
      "$comment": "Pattern = optional operator (~>, >=, <=, >, <, =, !=), optional whitespace, version (optional v prefix, 1 to 3 numeric segments: major, optional minor, optional patch, optional -prerelease, optional +build). Additional constraints are comma-separated with optional surrounding whitespace.",
      "pattern": "^\\s*(?:~>|>=|<=|>|<|=|!=)?\\s*v?[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?(?:\\s*,\\s*(?:~>|>=|<=|>|<|=|!=)?\\s*v?[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)*\\s*$",
      "examples": [
        "5.0.0",
        "v1.0.0",
        "~> 5.0",
        "~> 3.0.0-beta.1+build.5",
        ">= 1.5, < 2.0"
      ]
    }
  },
  "properties": {
    "terraform_version": {
      "allOf": [
        { "$ref": "#/definitions/versionConstraint" },
        {
          "description": "Optional: Terraform required_version constraint to set in terraform blocks",
          "examples": [
            ">= 1.5",
            "~> 1.6.0",
            ">= 1.5, < 2.0"
          ]
        }
      ]
    },
    "providers": {
      "type": "array",
      "description": "Optional: List of provider version updates to apply in terraform required_providers blocks",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Provider name (e.g., aws, azurerm, google)",
            "minLength": 1,
            "examples": [
              "aws",
              "azurerm",
              "google"
            ]
          },
          "version": {
            "allOf": [
              { "$ref": "#/definitions/versionConstraint" },
              {
                "description": "Target provider version constraint",
                "examples": [
                  "~> 5.0",
                  ">= 4.0, < 6.0"
                ]
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "description": "List of Terraform modules to update",
      "items": {
        "type": "object",
        "required": ["source", "version"],
        "properties": {
          "source": {
            "type": "string",
            "description": "The module source identifier. Registry and remote sources can be updated; local paths are accepted by the config loader but skipped during processing",
            "minLength": 1,
            "examples": [
              "terraform-aws-modules/vpc/aws",
              "terraform-aws-modules/iam/aws//modules/iam-user",
              "git::https://github.com/example/terraform-modules.git//vpc"
            ]
          },
          "version": {
            "allOf": [
              { "$ref": "#/definitions/versionConstraint" },
              {
                "description": "Target version or constraint to update the module to. Supports full SemVer 2.0.0 specification, pre-release/build metadata, and Terraform version constraint operators",
                "examples": [
                  "5.0.0",
                  "1.2.3",
                  "10.15.2",
                  "2.0.0-alpha",
                  "1.0.0-beta.1",
                  "3.5.0-rc.2+build.123",
                  "4.1.0+20240115",
                  "~> 5.0",
                  ">= 4.0, < 6.0"
                ]
              }
            ]
          },
          "from": {
            "oneOf": [
              {
                "allOf": [
                  { "$ref": "#/definitions/versionConstraint" },
                  {
                    "description": "Single exact version-attribute string to update from. The string may use Terraform constraint syntax",
                    "examples": [
                      "4.0.0",
                      "~> 3.0"
                    ]
                  }
                ]
              },
              {
                "type": "array",
                "description": "List of exact version-attribute strings to update from. The module is updated if its current string matches any item",
                "items": {
                  "$ref": "#/definitions/versionConstraint"
                },
                "minItems": 1,
                "examples": [
                  ["3.0.0", "~> 3.0"],
                  ["4.0.0", "4.1.0"]
                ]
              }
            ],
            "description": "Optional: Only update the module if its current version string exactly matches this value or any value in the list. Constraint syntax such as ~> 3.0 is compared literally"
          },
          "ignore_versions": {
            "oneOf": [
              {
                "allOf": [
                  { "$ref": "#/definitions/versionConstraint" },
                  {
                    "description": "Single exact version-attribute string to skip during updates",
                    "examples": [
                      "3.14.0",
                      "~> 3.0"
                    ]
                  }
                ]
              },
              {
                "type": "array",
                "description": "List of exact version-attribute strings to skip. The module is skipped if its current string matches any item",
                "items": {
                  "$ref": "#/definitions/versionConstraint"
                },
                "minItems": 1,
                "examples": [
                  ["3.0.0", "~> 3.0"],
                  ["3.14.0", "4.0.0"]
                ]
              }
            ],
            "description": "Optional: Skip modules whose current version string exactly matches one of these values. Takes precedence over the 'from' filter"
          },
          "ignore_modules": {
            "type": "array",
            "description": "Optional: List of module names or patterns to ignore. Supports wildcard matching using '*' for zero or more characters",
            "items": {
              "type": "string"
            },
            "examples": [
              ["vpc", "legacy-*"],
              ["test-*", "*-deprecated"],
              ["prod-vpc", "staging-*", "*-old"]
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "anyOf": [
    {
      "required": ["terraform_version"]
    },
    {
      "required": ["providers"]
    },
    {
      "required": ["modules"]
    }
  ],
  "additionalProperties": false,
  "examples": [
    {
      "terraform_version": ">= 1.5",
      "providers": [
        {
          "name": "aws",
          "version": "~> 5.0"
        }
      ],
      "modules": [
        {
          "source": "terraform-aws-modules/vpc/aws",
          "version": "5.0.0"
        }
      ]
    },
    {
      "modules": [
        {
          "source": "terraform-aws-modules/vpc/aws",
          "version": "5.0.0"
        }
      ]
    },
    {
      "modules": [
        {
          "source": "terraform-aws-modules/vpc/aws",
          "version": "5.0.0",
          "from": "4.0.0"
        },
        {
          "source": "terraform-aws-modules/s3-bucket/aws",
          "version": "4.0.0"
        }
      ]
    },
    {
      "modules": [
        {
          "source": "terraform-aws-modules/vpc/aws",
          "version": "5.0.0",
          "ignore_modules": ["legacy-vpc", "test-*"]
        },
        {
          "source": "terraform-aws-modules/s3-bucket/aws",
          "version": "4.0.0",
          "from": ["3.0.0", "~> 3.0"],
          "ignore_modules": ["*-deprecated"]
        }
      ]
    },
    {
      "modules": [
        {
          "source": "terraform-aws-modules/vpc/aws",
          "version": "5.0.0",
          "ignore_versions": ["3.14.0", "~> 3.0"]
        }
      ]
    }
  ]
}
